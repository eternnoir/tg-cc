# tg-cc Configuration
# Copy this file to .env and modify as needed

# ============================================
# Logging Configuration
# ============================================

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Log format: console, json (default: console)
LOG_FORMAT=console

# ============================================
# Session Persistence Configuration
# ============================================

# Path to SQLite database file for session persistence (optional)
# Sessions are stored to survive bot restarts
# Default: sessions.db (in current working directory)
DB_PATH=sessions.db

# ============================================
# Single Bot Configuration
# ============================================
# Use this format if you only need one bot

# Telegram bot token (get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Working directory for Claude Code
BOT_WORKING_DIR=/path/to/your/project

# Bot name (optional)
BOT_NAME=my-project-bot

# Whitelist of Telegram user IDs (comma-separated, optional)
# Leave empty to allow all users (not recommended for production)
# Get your user ID from @userinfobot or @getmyid_bot on Telegram
BOT_WHITELIST=123456789,987654321

# Additional Claude CLI arguments (optional)
# Space-separated arguments to pass to Claude CLI
# Examples:
#   BOT_CLAUDE_ARGS=--model claude-sonnet-4-20250514
#   BOT_CLAUDE_ARGS=--model claude-sonnet-4-20250514 --max-turns 5
#   BOT_CLAUDE_ARGS=--allowedTools Bash Read Write Edit
#   BOT_CLAUDE_ARGS=--permission-mode acceptEdits
# BOT_CLAUDE_ARGS=

# Temporary directory for file uploads (optional)
# If set, users can upload files which will be downloaded to this directory
# and their paths will be included in the message to Claude
# Note: Directory will be created automatically if it doesn't exist
# BOT_TEMP_DIR=/tmp/tg-cc-uploads

# ============================================
# Multiple Bots Configuration
# ============================================
# Uncomment and use this format for multiple bots
# Note: If BOT_TOKEN is set, the single bot format takes precedence

# Number of bots (optional, auto-detected if not set)
# BOT_COUNT=2

# First bot
# BOT_1_TOKEN=first_bot_token_here
# BOT_1_WORKING_DIR=/path/to/first/project
# BOT_1_NAME=frontend-bot
# BOT_1_WHITELIST=123456789
# BOT_1_CLAUDE_ARGS=--model claude-sonnet-4-20250514
# BOT_1_TEMP_DIR=/tmp/tg-cc-bot1-uploads

# Second bot
# BOT_2_TOKEN=second_bot_token_here
# BOT_2_WORKING_DIR=/path/to/second/project
# BOT_2_NAME=backend-bot
# BOT_2_WHITELIST=123456789,987654321
# BOT_2_CLAUDE_ARGS=--model claude-sonnet-4-20250514 --max-turns 10
# BOT_2_TEMP_DIR=/tmp/tg-cc-bot2-uploads
